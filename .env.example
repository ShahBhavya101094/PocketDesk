# Copy to .env for LOCAL development only. Never commit .env.
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_SIGNUP_ENABLED=True
# Empty means SQLite, allowed only with DEBUG=True and never on Vercel.
DATABASE_URL=

# Production: configure in Vercel, not in this file.
# DEBUG=False
# DJANGO_SECRET_KEY=<unique random secret with at least 50 characters>
# DJANGO_ALLOWED_HOSTS=your-project.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
# PUBLIC_SIGNUP_ENABLED=False
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
